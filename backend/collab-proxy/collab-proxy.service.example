# systemdのuserサービスとしてcollab-proxyを常駐させるためのテンプレート。
# backend/capture-proxy/capture-proxy.service.example と同じ使い方（sudo不要）。
#
# 使い方:
#   1. パス（WorkingDirectory / ExecStartのnodeバイナリ）を自分の環境に合わせて書き換える
#      （nodeのパスは `source ~/.nvm/nvm.sh && which node` で確認できる）
#   2. ~/.config/systemd/user/collab-proxy.service にコピー
#   3. systemctl --user daemon-reload
#   4. systemctl --user enable --now collab-proxy.service

[Unit]
Description=Free-Networking-labs collab-proxy (view-only share links)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/<your-username>/Free-Networking-labs/backend/collab-proxy
ExecStart=/home/<your-username>/.nvm/versions/node/<version>/bin/node server.js
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
