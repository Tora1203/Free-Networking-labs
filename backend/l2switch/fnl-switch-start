#!/bin/sh
# 起動のたびにstartup-configからrunning-configを作り直し（実機の電源投入と同じ）、
# エージェントを動かし続ける（落ちても1秒後に再起動）
mkdir -p /run/fnl-switch
if [ -f /etc/fnl-switch/startup.json ]; then
  cp /etc/fnl-switch/startup.json /run/fnl-switch/running.json
else
  rm -f /run/fnl-switch/running.json
fi
trap 'exit 0' TERM INT
while :; do
  /usr/local/bin/swcli --agent &
  wait $!
  sleep 1
done
