diff --git a/driver_deps.c b/driver_deps.c
index 6990292..0dc73da 100644
--- a/driver_deps.c
+++ b/driver_deps.c
@@ -1,3 +1,5 @@
+#include <stdio.h>
+#include <stdlib.h>
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 /*
  * driver_deps.c    Driver-specific code.
@@ -56,7 +58,14 @@ void driver_delete_port(port_t *prt)
  */
 int driver_set_new_state(per_tree_port_t *ptp, int new_state)
 {
-    /* TODO: insert driver-specific code here */
+    /* fnl: コンテナのネットワーク名前空間ではカーネルのユーザーSTPモードが使えないため、
+       各ツリーの状態をカーネルのMSTインスタンスのポート状態として設定する。
+       カーネルのMSTI 0は設定できないので、CIST（MSTID 0）はカーネルのMSTI 4094に対応させる */
+    char cmd[128];
+    int kmsti = (0 == ptp->MSTID) ? 4094 : __be16_to_cpu(ptp->MSTID);
+    snprintf(cmd, sizeof(cmd), "bridge mst set dev %s msti %d state %d >/dev/null 2>&1",
+             ptp->port->sysdeps.name, kmsti, new_state);
+    system(cmd);  /* そのMSTIにまだVLANが無いと失敗するが、VLANを割り当てた時にエージェントが合わせる */
     return new_state;
 }
 
