CAPTURE_PROXY_PORT=8084
CLAB_API_BASE_URL=https://localhost:8090
# TLS証明書（自己署名）。未設定時はcerts/cert.pem・certs/key.pemを使う。
# certs/ディレクトリで `openssl req -x509 -newkey rsa:2048 -keyout certs/key.pem -out certs/cert.pem
# -days 825 -nodes -subj "/CN=capture-proxy"` を実行して生成する（リポジトリには含めない）
CAPTURE_PROXY_TLS_CERT=./certs/cert.pem
CAPTURE_PROXY_TLS_KEY=./certs/key.pem
