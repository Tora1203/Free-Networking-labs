#!/bin/sh
# エージェントを裏で動かしてから、FRR公式イメージ本来の起動処理に入る（PID1はtini）
/usr/local/bin/fnl-subif-agent &
# LLDPとCDPv2を送る（スイッチの show lldp/cdp neighbors にこのルーターが出る）。名前はvtyshのhostnameに
# エージェントが合わせる。-ccc：CDPv2を常に送る、-l：LLDPを常に送る、-H 0：LLDPとCDPの両方を残す
lldpd -ccc -l -H 0 -k -I 'eth*,!eth0' -P FNL-Router -S 'Free-Networking-labs router (FRRouting)' >/dev/null 2>&1 &
exec /usr/lib/frr/docker-start
