# clab-api-server のベースURL。未設定時は https://localhost:8090 にフォールバックする（src/api/client.ts）。
# 開発サーバーとAPIサーバーが別ホストの場合はここを書き換える。
VITE_API_BASE_URL=https://localhost:8090

# 統合コンソール中継プロキシ（backend/console-proxy/）のURL。
# ブラウザのWebSocket APIがAuthorizationヘッダーを送れないための回避策。詳細はdocs/direction.md参照。
VITE_CONSOLE_PROXY_URL=ws://localhost:8082

# パケットキャプチャ中継プロキシ（backend/capture-proxy/）のURL。
# console-proxyと同じ理由（noVNCの資産取得・WebSocketがAuthorizationヘッダーを送れない）の回避策。
# HTTPS必須（noVNCのホストクリップボード自動同期がブラウザのClipboard API＝secure context
# を要求するため。backend/capture-proxy/README.md参照）
VITE_CAPTURE_PROXY_URL=https://localhost:8084

# 開発サーバーに許可する追加のホスト名（カンマ区切り）。`fnl`は標準で許可済み。
# IPアドレス・localhostは常に許可される。ホスト名でアクセスする場合、clab-api-serverと
# ovs-helperの`CORS_ALLOWED_ORIGINS`にも`http://<ホスト名>:5173`の追加が必要。
# ALLOWED_HOSTS=
