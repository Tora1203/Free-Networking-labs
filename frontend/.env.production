# 本番ビルド（`npm run build`）用。nginx（backend/nginx/）配下で同一オリジンに載せるため、
# 接続先を相対パスにする。`.env`の開発用の値（IP直指定）はここで上書きされる。
# clab-api-server: /login と /api/ を nginx が 8090 へ中継
VITE_API_BASE_URL=
# ovs-helper: /ovs/ を nginx が 8083 へ中継（prefixは除去される）
VITE_OVS_HELPER_URL=/ovs
# capture-proxy: /capture/ を nginx が 8084 へ中継
VITE_CAPTURE_PROXY_URL=
# console-proxy: 空にするとコード側で wss://<host>/console を使う
VITE_CONSOLE_PROXY_URL=
